# Database (Neon PostgreSQL serverless connection)
# If left unset, the application automatically falls back to an in-memory repository
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# PostHog Analytics (Client & Reverse Proxy)
PUBLIC_POSTHOG_KEY="phc_your_posthog_client_key"
PUBLIC_POSTHOG_HOST="/ingest"
POSTHOG_PROJECT_ID="your_posthog_project_id"
POSTHOG_PERSONAL_API_KEY="phx_your_posthog_personal_api_key"

# Autonomous AI Agent (OpenAI for qualitative CRO reasoning)
OPENAI_API_KEY="sk-proj-your_openai_api_key"
OPENAI_MODEL="gpt-5.6-luna"

# Admin Dashboard Gate (/marketingengine)
ADMIN_USER="admin"
ADMIN_PASSWORD="fxreplay"
