---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "FX Replay | Try Free - Market Replay Platform for Forex, Futures & Crypto",
  description = "Replay real historical markets, practice your strategy risk-free, and build consistency before trading live capital. Free to start, no credit card required."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://fxreplay.com');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary SEO Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080A0F" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://fxreplay.com/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://fxreplay.com/og-image.png" />

    <!-- Performance: Preconnect to Font & CDN origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Structured Data (JSON-LD) for SEO Authority -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "FX Replay",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web Browser",
        "offers": {
          "@type": "Offer",
          "price": "0.00",
          "priceCurrency": "USD",
          "category": "FreeTrial"
        },
        "description": "Browser-based market replay and backtesting platform for Forex, Futures, and Crypto traders.",
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "12500"
        }
      }
    </script>
  </head>
  <body class="bg-fxr-bg text-fxr-text antialiased min-h-screen selection:bg-blue-600 selection:text-white">
    <slot />
  </body>
</html>
