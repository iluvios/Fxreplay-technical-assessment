---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FX Replay | Try Free — Market Replay Platform for Forex, Futures & Crypto',
  description = 'Replay real historical markets, practice your strategy risk-free, and build consistency before trading live capital. Free to start, no credit card required.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://fxreplay.com');

// Brand kit type stack: Lato (headings) · Nunito Sans (body/UI) · JetBrains Mono (metrics).
const FONT_HREF =
  'https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&family=JetBrains+Mono:wght@400;500&display=swap';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030303" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Fonts: preconnect + preload the stylesheet so text paints without FOIT -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONT_HREF} />
    <link rel="stylesheet" href={FONT_HREF} />

    <!-- Structured data for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'FX Replay',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
        category: 'FreeTrial',
      },
      description:
        'Browser-based market replay and backtesting platform for Forex, Futures, and Crypto traders.',
    })} />
  </head>
  <body class="min-h-screen bg-surface font-sans text-ink antialiased selection:bg-brand selection:text-white">
    <slot />
  </body>
</html>
