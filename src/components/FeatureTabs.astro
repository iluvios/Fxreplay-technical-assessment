---
// Feature tabs — docs/FRONTEND_BUILD_SPEC.md §3.4
// Zero client JS: tab switching is a pure CSS radio-input pattern.
import type { ExperimentVariantCopy } from '../lib/copy-dictionary';
import ProductMockup, { type MockupVariant } from './ProductMockup.astro';

interface Props {
  copy: ExperimentVariantCopy;
  /** Signup destination, already carrying experiment or personalisation context. */
  ctaHref: string;
}

const { copy, ctaHref } = Astro.props;

// Baseline tab content. Every string is sourced from docs/EXPERIMENT_VARIANTS_COPY.md
// (control "Key Features List" + the variant whose active tab is that surface).
const TABS: { id: string; label: string; title: string; description: string; cta_text: string; mockup: MockupVariant }[] = [
  {
    id: 'ft-0',
    label: 'Journal',
    title: 'Track every move',
    description:
      'Backtest using historical data and see how your setups perform with zero risk and no emotional bias.',
    cta_text: 'Start now',
    mockup: 'journal',
  },
  {
    id: 'ft-1',
    label: 'Prop firm simulator',
    title: 'Train under real evaluation rules',
    description:
      'Simulate prop firm challenges with real rules and conditions to prepare for funded accounts.',
    cta_text: 'Start prop simulation',
    mockup: 'prop_firm_overlay',
  },
  {
    id: 'ft-2',
    label: 'AI Coach',
    title: 'Get feedback on every session',
    description:
      'Get AI-powered feedback on your trading behavior to identify patterns and improve performance.',
    cta_text: 'Start now',
    mockup: 'coach',
  },
  {
    id: 'ft-3',
    label: 'Strategy Script',
    title: 'Zero lookahead leaks. Sub-second tick accuracy.',
    description:
      'Switch from the Daily to the 1-minute chart without flashing future price action. Backtest with the mathematical integrity TradingView lacks.',
    cta_text: 'Test tick precision',
    mockup: 'script',
  },
];

// Which tab each variant opens on (docs/EXPERIMENT_VARIANTS_COPY.md §3, "Feature Tabs Copy (X active)").
const ACTIVE_TAB_BY_VARIANT: Record<string, number> = {
  control: 0,
  prop_firm_hunter: 1,
  weekend_warrior: 0,
  tv_skeptic: 3,
};

const activeIndex = ACTIVE_TAB_BY_VARIANT[copy.variant_id] ?? 0;

// The variant's own copy overrides the baseline content of its active tab.
const tabs = TABS.map((tab, i) =>
  i === activeIndex
    ? {
        ...tab,
        title: copy.feature_tab.title,
        description: copy.feature_tab.description,
        cta_text: copy.feature_tab.cta_text,
      }
    : tab
);

---

<section id="features" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="ft-tabs">
    <input type="radio" name="ft-feature-tab" id="ft-0" checked={activeIndex === 0} />
    <input type="radio" name="ft-feature-tab" id="ft-1" checked={activeIndex === 1} />
    <input type="radio" name="ft-feature-tab" id="ft-2" checked={activeIndex === 2} />
    <input type="radio" name="ft-feature-tab" id="ft-3" checked={activeIndex === 3} />

    <!-- Tab switcher -->
    <div
      class="ft-tablist mx-auto mb-10 flex w-fit max-w-full flex-wrap justify-center gap-1 rounded-full border border-line bg-surface-raised p-1.5"
      role="tablist"
    >
      {
        tabs.map((tab) => (
          <label
            for={tab.id}
            class="cursor-pointer rounded-full px-4 py-2 text-sm font-semibold text-ink-muted transition-colors hover:text-ink"
          >
            {tab.label}
          </label>
        ))
      }
    </div>

    <!-- Panels -->
    <div class="ft-panels">
      {
        tabs.map((tab) => (
          <div
            class="ft-panel items-center gap-10 rounded-2xl border border-line bg-surface-raised p-6 md:p-10 lg:grid-cols-2"
            data-panel={tab.id}
          >
            <div>
              <h2 class="mb-4 text-3xl font-black text-ink md:text-4xl">{tab.title}</h2>
              <p class="mb-6 leading-relaxed text-ink-muted">{tab.description}</p>
              <a
                href={ctaHref}
                data-analytics-cta="feature_tabs"
                class="inline-block rounded-full bg-brand px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-hover"
              >
                {tab.cta_text}
              </a>
            </div>
            <div class="overflow-hidden rounded-xl border border-line bg-surface-inset">
              <ProductMockup variant={tab.mockup} label={tab.label} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ft-tabs > input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ft-panel {
    display: none;
  }

  /* Active panel */
  #ft-0:checked ~ .ft-panels .ft-panel[data-panel='ft-0'],
  #ft-1:checked ~ .ft-panels .ft-panel[data-panel='ft-1'],
  #ft-2:checked ~ .ft-panels .ft-panel[data-panel='ft-2'],
  #ft-3:checked ~ .ft-panels .ft-panel[data-panel='ft-3'] {
    display: grid;
  }

  /* Active tab pill */
  #ft-0:checked ~ .ft-tablist label[for='ft-0'],
  #ft-1:checked ~ .ft-tablist label[for='ft-1'],
  #ft-2:checked ~ .ft-tablist label[for='ft-2'],
  #ft-3:checked ~ .ft-tablist label[for='ft-3'] {
    background-color: theme('colors.surface.inset');
    color: theme('colors.ink.DEFAULT');
  }

  /* Keyboard focus parity with mouse users */
  .ft-tabs > input[type='radio']:focus-visible ~ .ft-tablist label {
    outline: 2px solid theme('colors.brand.DEFAULT');
    outline-offset: 2px;
  }
</style>
