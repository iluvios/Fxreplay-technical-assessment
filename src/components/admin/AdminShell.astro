---
// Chrome for /marketingengine — the internal growth console.
//
// Zero client JavaScript, same as the marketing pages. Every interaction in the admin
// is a plain <form method="post"> against an API route that redirects back, so the
// console works with scripting disabled and has no hydration cost to justify.
import Layout from '../../layouts/Layout.astro';

interface Props {
  title: string;
  /** Short line under the page title explaining what the screen is for. */
  subtitle?: string;
  /** Nav item to mark as current. */
  active: 'overview' | 'experiments' | 'users' | 'agent';
}

const { title, subtitle, active } = Astro.props;

const NAV = [
  { key: 'overview', label: 'Overview', href: '/marketingengine' },
  { key: 'experiments', label: 'Experiments', href: '/marketingengine/experiments' },
  { key: 'users', label: 'Users', href: '/marketingengine/users' },
  { key: 'agent', label: 'Agent', href: '/marketingengine/agent' },
] as const;

// Surfaced by API routes after a redirect, so a form post can report what happened
// without any client-side state.
const notice = Astro.url.searchParams.get('ok');
const problem = Astro.url.searchParams.get('err');
---

<Layout title={`${title} · FX Replay Growth Engine`} description="Internal growth console.">
  <div class="min-h-screen bg-surface">
    <header class="border-b border-line bg-surface-raised">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
        <div class="flex items-center gap-6">
          <a href="/marketingengine" class="font-display text-sm font-black tracking-tight text-ink">
            FX Replay <span class="text-brand-light">Growth Engine</span>
          </a>
          <nav class="hidden items-center gap-1 md:flex">
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.key === active ? 'page' : undefined}
                  class:list={[
                    'rounded-md px-3 py-1.5 text-sm font-semibold transition-colors',
                    item.key === active
                      ? 'bg-surface-inset text-ink'
                      : 'text-ink-subtle hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="flex items-center gap-4">
          <a
            href="/freetrial?lp=1"
            class="hidden text-xs font-semibold text-ink-subtle transition-colors hover:text-ink sm:inline"
          >
            View landing page ↗
          </a>
          <form method="post" action="/api/admin/session?_method=delete">
            <button
              type="submit"
              class="rounded-md border border-line-strong px-3 py-1.5 text-xs font-semibold text-ink-muted transition-colors hover:border-line-strongest hover:text-ink"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>

      <nav class="flex gap-1 overflow-x-auto border-t border-line px-4 py-2 md:hidden">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class:list={[
                'whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-semibold',
                item.key === active ? 'bg-surface-inset text-ink' : 'text-ink-subtle',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <div class="mb-6">
        <h1 class="font-display text-2xl font-black tracking-tight text-ink">{title}</h1>
        {subtitle && <p class="mt-1 text-sm text-ink-subtle">{subtitle}</p>}
      </div>

      {
        notice && (
          <p class="mb-6 rounded-lg border border-success-dark bg-success-dark/15 px-4 py-3 text-sm text-success">
            {notice}
          </p>
        )
      }
      {
        problem && (
          <p class="mb-6 rounded-lg border border-error-dark bg-error-dark/15 px-4 py-3 text-sm text-error">
            {problem}
          </p>
        )
      }

      <slot />
    </main>
  </div>
</Layout>
