---
// Multi-asset coverage grid — docs/FRONTEND_BUILD_SPEC.md §3.6
// Symbol badges are drawn in CSS; no third-party logos or image requests.
interface Props {
  /** Signup destination, already carrying experiment or personalisation context. */
  ctaHref: string;
}

const { ctaHref } = Astro.props;

const filters = ['Forex', 'Futures', 'Stocks', 'Crypto', 'Indexes', 'Other'];

const assets = [
  {
    symbol: 'EURUSD',
    tag: 'Forex',
    data: 'Tick + 1m bars',
    plan: 'Beginner+',
    timeframes: '5s, 1m, 1h, 1D, +6',
    initialDate: 'January 2, 2005',
  },
  {
    symbol: 'USDCHF',
    tag: 'Forex',
    data: 'Tick + 1m bars',
    plan: 'Beginner+',
    timeframes: '5s, 1m, 1h, 1D, +6',
    initialDate: 'January 2, 2005',
  },
  {
    symbol: 'DXY',
    tag: 'Indexes',
    data: '1m bars',
    plan: 'Beginner+',
    timeframes: '1m, 1h, 1D, +4',
    initialDate: 'March 14, 2007',
  },
  {
    symbol: 'SPX500',
    tag: 'Indexes',
    data: '1m bars',
    plan: 'Intermediate+',
    timeframes: '5s, 1m, 1h, 1D, +6',
    initialDate: 'January 2, 2008',
  },
  {
    symbol: 'NAS100',
    tag: 'Indexes',
    data: '1m bars',
    plan: 'Intermediate+',
    timeframes: '5s, 1m, 1h, 1D, +6',
    initialDate: 'January 2, 2008',
  },
  {
    symbol: 'US30',
    tag: 'Indexes',
    data: 'Tick + 1m bars',
    plan: 'Intermediate+',
    timeframes: '1m, 1h, 1D, +4',
    initialDate: 'June 1, 2010',
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mb-8 flex items-center justify-between">
    <h2 class="text-3xl font-black text-ink md:text-4xl">Assets</h2>
    <a
      href={ctaHref}
      data-analytics-cta="asset_coverage"
      class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink-muted transition-colors hover:border-line-strong hover:text-ink"
    >
      Explore more
    </a>
  </div>

  <!-- Category filters -->
  <div class="mb-8 flex flex-wrap gap-2">
    {
      filters.map((filter, i) => (
        <span
          class={`rounded-full px-4 py-1.5 text-sm font-semibold ${
            i === 0 ? 'bg-brand text-white' : 'border border-line bg-surface-raised text-ink-muted'
          }`}
        >
          {filter}
        </span>
      ))
    }
  </div>

  <!-- Asset grid -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      assets.map((asset) => (
        <article class="rounded-2xl border border-line bg-surface-raised p-5 transition-colors hover:border-line-strong">
          <div class="mb-4 flex items-center gap-3">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-inset font-mono text-[11px] font-medium text-brand-light"
              aria-hidden="true"
            >
              {asset.symbol.slice(0, 2)}
            </span>
            <div>
              <h3 class="font-mono text-base font-medium text-ink">{asset.symbol}</h3>
              <span class="text-xs text-ink-subtle">{asset.tag}</span>
            </div>
          </div>

          <dl class="space-y-3 text-xs">
            <div class="flex justify-between gap-2">
              <dt class="text-ink-subtle">Data:</dt>
              <dd class="font-semibold text-ink">{asset.data}</dd>
            </div>

            <div class="flex justify-between gap-2">
              <dt class="text-ink-subtle">Plan access:</dt>
              <dd class="font-semibold text-ink">{asset.plan}</dd>
            </div>

            <div class="flex justify-between gap-2">
              <dt class="text-ink-subtle">Timeframes:</dt>
              <dd class="font-mono text-ink">{asset.timeframes}</dd>
            </div>

            <div class="flex justify-between gap-2">
              <dt class="text-ink-subtle">Initial date:</dt>
              <dd class="font-mono text-ink">{asset.initialDate}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</section>
