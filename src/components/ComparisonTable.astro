---
import { Check, X, Sparkles } from 'lucide-react';
---

<section id="comparison" class="py-16 md:py-24 border-t border-fxr-border/60 bg-fxr-bg">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-semibold text-fxr-primary uppercase tracking-widest mb-2 font-mono">
        The Competitive Edge
      </h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-fxr-text tracking-tight">
        Why Traders Choose FX Replay
      </p>
      <p class="text-fxr-muted text-sm sm:text-base mt-2">
        Compare how FX Replay accelerates your development vs. legacy alternatives.
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="overflow-x-auto rounded-2xl border border-fxr-border bg-fxr-card shadow-xl">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-fxr-border bg-fxr-bg/80">
            <th class="p-4 sm:p-5 font-semibold text-fxr-text w-1/3">Capability</th>
            <th class="p-4 sm:p-5 font-bold text-blue-400 bg-blue-500/10 border-x border-blue-500/20 w-1/3 text-center">
              <span class="inline-flex items-center gap-1.5">
                <Sparkles className="w-4 h-4" />
                <span>FX Replay</span>
              </span>
            </th>
            <th class="p-4 sm:p-5 font-medium text-fxr-muted w-1/3 text-center">Standard Bar Replay</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fxr-border">
          <tr>
            <td class="p-4 sm:p-5 text-fxr-text font-medium">Tick-precise execution & realistic slippage</td>
            <td class="p-4 sm:p-5 text-center bg-blue-500/5 border-x border-blue-500/20">
              <Check className="w-5 h-5 text-fxr-accent mx-auto" />
            </td>
            <td class="p-4 sm:p-5 text-center text-fxr-subtle">
              <X className="w-5 h-5 text-fxr-danger mx-auto" />
            </td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 text-fxr-text font-medium">Multi-timeframe simultaneous chart sync</td>
            <td class="p-4 sm:p-5 text-center bg-blue-500/5 border-x border-blue-500/20">
              <Check className="w-5 h-5 text-fxr-accent mx-auto" />
            </td>
            <td class="p-4 sm:p-5 text-center text-fxr-subtle">
              <span class="text-xs text-fxr-muted">Limited</span>
            </td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 text-fxr-text font-medium">Automated Trade Journal with MAE/MFE</td>
            <td class="p-4 sm:p-5 text-center bg-blue-500/5 border-x border-blue-500/20">
              <Check className="w-5 h-5 text-fxr-accent mx-auto" />
            </td>
            <td class="p-4 sm:p-5 text-center text-fxr-subtle">
              <X className="w-5 h-5 text-fxr-danger mx-auto" />
            </td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 text-fxr-text font-medium">Built-in Prop Firm Challenge Simulator</td>
            <td class="p-4 sm:p-5 text-center bg-blue-500/5 border-x border-blue-500/20">
              <Check className="w-5 h-5 text-fxr-accent mx-auto" />
            </td>
            <td class="p-4 sm:p-5 text-center text-fxr-subtle">
              <X className="w-5 h-5 text-fxr-danger mx-auto" />
            </td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 text-fxr-text font-medium">Seconds-level candle granularity (5s, 15s)</td>
            <td class="p-4 sm:p-5 text-center bg-blue-500/5 border-x border-blue-500/20">
              <Check className="w-5 h-5 text-fxr-accent mx-auto" />
            </td>
            <td class="p-4 sm:p-5 text-center text-fxr-subtle">
              <X className="w-5 h-5 text-fxr-danger mx-auto" />
            </td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 text-fxr-text font-medium">Free plan with no credit card required</td>
            <td class="p-4 sm:p-5 text-center bg-blue-500/5 border-x border-blue-500/20">
              <Check className="w-5 h-5 text-fxr-accent mx-auto" />
            </td>
            <td class="p-4 sm:p-5 text-center text-fxr-subtle">
              <span class="text-xs text-fxr-muted">Paid sub required</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
