---
import { Check, ArrowRight, ShieldCheck } from 'lucide-react';
---

<section id="pricing" class="py-16 md:py-24 border-t border-fxr-border/60 bg-gradient-to-b from-[#0B0E17] to-fxr-bg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-xs font-semibold text-fxr-primary uppercase tracking-widest mb-2 font-mono">
        Transparent Pricing
      </h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-fxr-text tracking-tight">
        Start Free, Upgrade When You're Ready
      </p>
      <p class="text-fxr-muted text-sm sm:text-base mt-2">
        Test our backtesting engine risk-free. No credit card required to get started.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
      
      <!-- Free Plan (Highlighted as Challenge Opportunity) -->
      <div class="p-6 sm:p-8 rounded-2xl bg-fxr-card border-2 border-fxr-primary relative flex flex-col justify-between shadow-xl shadow-blue-600/10">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-fxr-primary text-white text-[11px] font-bold tracking-wide uppercase">
          Current Opportunity
        </div>

        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-blue-400 font-mono">Free Forever</div>
          <h3 class="text-2xl font-bold text-fxr-text mt-1">Starter Replay</h3>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold font-mono text-fxr-text">$0</span>
            <span class="text-xs text-fxr-muted">/ forever</span>
          </div>
          <p class="text-xs text-fxr-muted mt-2">Perfect for exploring the platform and testing your first strategy.</p>

          <ul class="mt-6 space-y-3 text-xs text-fxr-text">
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Core historical Forex data</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Standard candlestick replay</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Full TradingView charting indicators</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>No credit card required</span>
            </li>
          </ul>
        </div>

        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="mt-8 w-full py-3 px-4 rounded-xl font-semibold text-xs text-white bg-fxr-primary hover:bg-fxr-primaryHover active:scale-95 transition-all shadow-md shadow-blue-600/20 text-center flex items-center justify-center gap-2"
        >
          <span>Start Free Today</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </button>
      </div>

      <!-- Intermediate Plan -->
      <div class="p-6 sm:p-8 rounded-2xl bg-fxr-card border border-fxr-border flex flex-col justify-between hover:border-fxr-borderLight transition-all">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-fxr-muted font-mono">Standard</div>
          <h3 class="text-2xl font-bold text-fxr-text mt-1">Intermediate</h3>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold font-mono text-fxr-text">$15</span>
            <span class="text-xs text-fxr-muted">/ month (billed annually)</span>
          </div>
          <p class="text-xs text-fxr-muted mt-2">For consistent traders backtesting multiple sessions per week.</p>

          <ul class="mt-6 space-y-3 text-xs text-fxr-text">
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Unlimited backtesting sessions</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Automated Journal & Analytics</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Prop Firm Challenge Simulator</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Multi-chart layout sync</span>
            </li>
          </ul>
        </div>

        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="mt-8 w-full py-3 px-4 rounded-xl font-semibold text-xs text-fxr-text bg-fxr-border hover:bg-fxr-borderLight transition-all text-center"
        >
          Explore Intermediate
        </button>
      </div>

      <!-- Pro Plan -->
      <div class="p-6 sm:p-8 rounded-2xl bg-fxr-card border border-fxr-border flex flex-col justify-between hover:border-fxr-borderLight transition-all">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-amber-400 font-mono">Elite Traders</div>
          <h3 class="text-2xl font-bold text-fxr-text mt-1">Pro Suite</h3>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold font-mono text-fxr-text">$29.16</span>
            <span class="text-xs text-fxr-muted">/ month (billed annually)</span>
          </div>
          <p class="text-xs text-fxr-muted mt-2">For funded traders requiring seconds-level precision & futures data.</p>

          <ul class="mt-6 space-y-3 text-xs text-fxr-text">
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>5-second & 15-second tick candles</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Futures, Stocks, and Crypto tick feeds</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>AI Trade Playbook Mentor</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-fxr-accent shrink-0" />
              <span>Priority execution speed & support</span>
            </li>
          </ul>
        </div>

        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="mt-8 w-full py-3 px-4 rounded-xl font-semibold text-xs text-fxr-text bg-fxr-border hover:bg-fxr-borderLight transition-all text-center"
        >
          Explore Pro
        </button>
      </div>

    </div>
  </div>
</section>
