---
// Dedicated signup page — deliberately not a modal, so the step is linkable,
// back-button friendly, and has no focus trap to manage.
//
// The experiment arm is re-derived from the visitor cookie rather than read from the URL,
// so the copy here always matches the arm the visitor saw on the landing page and cannot
// be changed by editing the query string.
import Layout from '../layouts/Layout.astro';
import SignupForm from '../components/SignupForm';
import { resolveLiveExperience } from '../lib/experiment-repo';
import { getOrCreateVisitorId, rememberEnrolment } from '../lib/visitor';
import { getOrCreateAttribution } from '../lib/attribution';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const visitorId = getOrCreateVisitorId(Astro.cookies);

// Captured here too: a visitor can land directly on /signup from an ad.
getOrCreateAttribution(Astro.cookies, Astro.url, Astro.request.headers.get('referer'));

const lp = Astro.url.searchParams.get('lp');
const { copy, assignment } = await resolveLiveExperience({
  lp,
  previewVariant: Astro.url.searchParams.get('variant'),
  visitorId,
});

rememberEnrolment(Astro.cookies, assignment);

const LOGO_URL =
  'https://cdn.prod.website-files.com/667eb56e859feb725a6a82a1/6a02920e2b4fe38ee5a3a06a_fxreplay-logo.svg';

// Reassurance at the point of commitment. Each line answers an unspoken objection:
// what will it cost, is the data real, do I have to do the boring part, can I leave.
const trustPoints = [
  {
    title: 'Free to start, no card',
    body: 'Create an account and open a replay session immediately. Nothing to enter, nothing to cancel.',
  },
  {
    title: 'Real historical markets',
    body: 'Forex, futures, stocks and crypto — actual price data, not a simulation of one.',
  },
  {
    title: 'Every trade journalled',
    body: 'Entry, exit, R:R and drawdown captured automatically. No spreadsheet to keep up with.',
  },
];

// The two pillars this arm leads with, reused as reinforcement beside the form so the
// page continues the argument the landing page started rather than dropping it.
const reinforcement = copy.pillars.slice(0, 2);
const review = copy.reviews[0];
---

<Layout title={`${copy.modal.title} | FX Replay`} description={copy.modal.subtitle}>
  <div
    data-signup-root
    data-variant-id={copy.variant_id}
    data-experiment-id={assignment && !assignment.is_preview ? assignment.experiment_id : ''}
    class="relative flex min-h-screen flex-col overflow-hidden"
  >
    <!-- Same ambient brand glow as the hero, so the funnel feels continuous. -->
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-brand/10 blur-[140px]"
      aria-hidden="true"
    >
    </div>

    <header class="relative border-b border-line/60">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="transition-opacity hover:opacity-80" aria-label="FX Replay home">
          <img src={LOGO_URL} alt="FX Replay" width="120" height="26" class="h-6 w-auto" />
        </a>
        <a
          href="/"
          class="text-sm font-semibold text-ink-subtle transition-colors hover:text-ink"
        >
          ← Back to site
        </a>
      </div>
    </header>

    <main
      class="relative mx-auto grid w-full max-w-6xl flex-1 gap-12 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_460px] lg:gap-20 lg:py-20"
    >
      <!-- Value reinforcement: keeps the promise visible while the form is filled in. -->
      <section class="lg:pt-4">
        <p
          class="mb-5 inline-block rounded-full border border-brand/25 bg-brand/10 px-3 py-1 font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-brand-light"
        >
          {copy.eyebrow}
        </p>

        <h1 class="mb-4 font-display text-3xl font-black leading-[1.15] text-ink md:text-[2.75rem]">
          {copy.modal.title}
        </h1>
        <p class="mb-10 max-w-md text-base leading-relaxed text-ink-muted">
          {copy.modal.subtitle}
        </p>

        <ul class="mb-10 space-y-5">
          {
            trustPoints.map((point) => (
              <li class="flex gap-3.5">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-success/40 bg-success/10"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 fill-none stroke-success stroke-[2.5]">
                    <path d="M2 6.2 4.6 8.8 10 3.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <div>
                  <p class="text-sm font-bold text-ink">{point.title}</p>
                  <p class="mt-0.5 text-sm leading-relaxed text-ink-subtle">{point.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Arm-specific reinforcement: the same two pillars the landing page led with. -->
        <div class="mb-10 grid gap-4 sm:grid-cols-2">
          {
            reinforcement.map((pillar) => (
              <div class="rounded-xl border border-line bg-surface-raised/60 p-4">
                <p class="text-sm font-bold text-ink">{pillar.title}</p>
                <p class="mt-1.5 text-xs leading-relaxed text-ink-subtle">{pillar.description}</p>
              </div>
            ))
          }
        </div>

        {
          review && (
            <figure class="max-w-md border-l-2 border-brand/40 pl-5">
              <blockquote class="text-sm leading-relaxed text-ink-muted">
                “{review.quote}”
              </blockquote>
              <figcaption class="mt-3 flex items-center gap-2 text-xs">
                <span class="font-bold text-ink">{review.name}</span>
                <span class="text-ink-subtle">·</span>
                <span class="text-ink-subtle">{review.role}</span>
                {review.verified && (
                  <span class="rounded bg-success/10 px-1.5 py-0.5 font-mono text-[10px] text-success">
                    {review.credential}
                  </span>
                )}
              </figcaption>
            </figure>
          )
        }
      </section>

      <section class="lg:pt-4">
        <SignupForm
          client:load
          lp={lp}
          submitLabel={copy.modal.cta_text}
          variantId={copy.variant_id}
          experimentId={assignment && !assignment.is_preview ? assignment.experiment_id : null}
        />

        <p class="mt-5 text-center text-xs text-ink-subtle">
          Already have an account?{' '}
          <a href="/" class="font-semibold text-brand-light hover:underline">Sign in</a>
        </p>
      </section>
    </main>

    <footer class="relative border-t border-line/60 py-6">
      <p class="mx-auto max-w-6xl px-4 text-xs leading-relaxed text-ink-subtle sm:px-6">
        Trading leveraged products carries a high level of risk. Simulated performance does not
        represent actual trading and is not indicative of future results.
      </p>
    </footer>
  </div>
</Layout>

<script>
  import { analytics } from '../lib/analytics';

  const root = document.querySelector<HTMLElement>('[data-signup-root]');
  const experiment_id = root?.dataset.experimentId || undefined;

  analytics.init();
  analytics.track('signup_page_viewed', {
    variant_id: root?.dataset.variantId ?? 'control',
    ...(experiment_id ? { experiment_id } : {}),
  });
</script>
