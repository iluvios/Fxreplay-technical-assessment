---
// Root landing page. Renders the same experience as /freetrial so traffic pointed at
// either URL resolves the same experiment arm.
// See freetrial.astro for the full rationale.
import LandingPage from '../components/LandingPage.astro';
import { resolveLiveExperience } from '../lib/experiment-repo';
import { getOrCreateVisitorId, rememberEnrolment } from '../lib/visitor';
import { getOrCreateAttribution } from '../lib/attribution';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const visitorId = getOrCreateVisitorId(Astro.cookies);
const attribution = getOrCreateAttribution(
  Astro.cookies,
  Astro.url,
  Astro.request.headers.get('referer')
);

const lp = Astro.url.searchParams.get('lp');
const { copy, assignment } = await resolveLiveExperience({
  lp,
  previewVariant: Astro.url.searchParams.get('variant'),
  visitorId,
});

rememberEnrolment(Astro.cookies, assignment);
---

<LandingPage
  copy={copy}
  lp={lp}
  assignment={assignment}
  visitorId={visitorId}
  attribution={attribution}
/>
