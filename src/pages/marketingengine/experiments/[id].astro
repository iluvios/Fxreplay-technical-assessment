---
// Experiment deep-dive: arms, live statistics, copy diff, and the agent's decision history.
import AdminShell from '../../../components/admin/AdminShell.astro';
import StatTile from '../../../components/admin/StatTile.astro';
import StatusPill from '../../../components/admin/StatusPill.astro';
import { experimentDb, EXPERIMENT_STATUSES } from '../../../lib/experiment-repo';
import { collectMetrics } from '../../../lib/agent/collect';
import { judgeExperiment } from '../../../lib/agent/decide';
import { COPY_DICTIONARY } from '../../../lib/copy-dictionary';
import { formatPct, formatSignedPct } from '../../../lib/stats';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const id = Astro.params.id!;
const experiment = await experimentDb.get(id);

if (!experiment) {
  return new Response('Experiment not found', { status: 404 });
}

const [icps, decisions] = await Promise.all([
  experimentDb.listIcps(),
  experimentDb.listDecisions(id, 25),
]);

// The same collector and judge the agent uses, so what the dashboard shows and what the
// agent would decide can never disagree. Read-only here — nothing is executed or logged.
const metrics = await collectMetrics({ experiment });
const verdict = judgeExperiment(metrics);
const primary = verdict.primary;

const icp = icps.find((candidate) => candidate.id === experiment.icp_id) ?? null;

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
});

const inputClass =
  'w-full rounded-lg border border-line-strong bg-surface-inset px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-brand';
const labelClass = 'mb-1.5 block text-xs font-semibold uppercase tracking-wide text-ink-subtle';

const DECISION_TONE: Record<string, string> = {
  PROMOTE: 'text-success',
  KILL: 'text-error',
  HUMAN_REVIEW: 'text-warning',
  CONTINUE: 'text-ink-subtle',
};

// Side-by-side copy comparison is the point of a messaging test: when an arm wins you
// want to see the sentence that won, not just its key.
const copyFields = [
  { key: 'eyebrow', label: 'Eyebrow' },
  { key: 'headline', label: 'Headline' },
  { key: 'subheadline', label: 'Subheadline' },
  { key: 'cta_text', label: 'Primary CTA' },
  { key: 'cta_subtext', label: 'CTA microcopy' },
] as const;

function copyValue(variantKey: string, field: (typeof copyFields)[number]['key']): string {
  const copy = COPY_DICTIONARY[variantKey];
  if (!copy) return '—';
  if (field === 'eyebrow') return copy.eyebrow;
  return copy.hero[field];
}
---

<AdminShell title={experiment.name} subtitle={experiment.hypothesis} active="experiments">
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <StatusPill status={experiment.status} />
    <span class="font-mono text-xs text-ink-subtle">?lp={experiment.id}</span>
    {icp && <span class="text-xs text-ink-muted">Targeting {icp.name}</span>}
    <a
      href={`/freetrial?lp=${experiment.id}`}
      class="text-xs font-semibold text-brand-light hover:underline"
    >
      Open landing page ↗
    </a>
  </div>

  <!-- ── Live verdict ──────────────────────────────────────────────────────── -->
  <section class="mb-10">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-display text-lg font-bold text-ink">Current reading</h2>
      <form method="post" action="/api/engine/evaluate">
        <input type="hidden" name="experiment_id" value={experiment.id} />
        <button
          type="submit"
          class="rounded-lg bg-brand px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-brand-hover"
        >
          Run agent evaluation now
        </button>
      </form>
    </div>

    {
      primary ? (
        <>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <StatTile
              label="Control CR"
              value={formatPct(primary.test.control_cr)}
              hint={`${primary.test.control.conversions} / ${primary.test.control.visitors} visitors`}
            />
            <StatTile
              label="Variant CR"
              value={formatPct(primary.test.variant_cr)}
              hint={`${primary.test.variant.conversions} / ${primary.test.variant.visitors} visitors`}
            />
            <StatTile
              label="Relative lift"
              value={formatSignedPct(primary.test.relative_lift_pct)}
              hint={`p = ${primary.test.p_value === null ? 'n/a' : primary.test.p_value.toFixed(4)}`}
              tone={
                (primary.test.relative_lift_pct ?? 0) > 0
                  ? 'positive'
                  : (primary.test.relative_lift_pct ?? 0) < 0
                    ? 'negative'
                    : 'neutral'
              }
            />
            <StatTile
              label="Sample"
              value={
                primary.test.is_underpowered
                  ? `${primary.test.remaining_visitors} short`
                  : 'Powered'
              }
              hint={`Target ${primary.test.sample_target} per arm`}
              tone={primary.test.is_underpowered ? 'neutral' : 'positive'}
            />
          </div>

          <div class="mt-4 rounded-xl border border-line bg-surface-raised p-5">
            <p class="mb-2 flex flex-wrap items-center gap-3">
              <span class:list={['font-mono text-sm font-medium', DECISION_TONE[primary.decision]]}>
                {primary.decision.replace('_', ' ')}
              </span>
              <span class="text-xs text-ink-subtle">
                would be the agent's call on today's numbers · source: {metrics.source}
              </span>
            </p>
            <p class="text-sm leading-relaxed text-ink-muted">{primary.rationale}</p>

            {metrics.notes.length > 0 && (
              <ul class="mt-3 space-y-1 border-t border-line pt-3">
                {metrics.notes.map((note) => (
                  <li class="text-xs text-warning">{note}</li>
                ))}
              </ul>
            )}
          </div>
        </>
      ) : (
        <p class="rounded-xl border border-line bg-surface-raised p-5 text-sm text-ink-muted">
          {verdict.blocked_reason ?? 'Not enough structure to evaluate this experiment.'}
        </p>
      )
    }
  </section>

  <!-- ── Arms ──────────────────────────────────────────────────────────────── -->
  <section class="mb-10">
    <h2 class="mb-3 font-display text-lg font-bold text-ink">Arms</h2>
    <div class="overflow-x-auto rounded-xl border border-line bg-surface-raised">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-line text-xs uppercase tracking-wide text-ink-subtle">
          <tr>
            <th class="px-4 py-3 font-semibold">Arm</th>
            <th class="px-4 py-3 font-semibold">Key</th>
            <th class="px-4 py-3 text-right font-semibold">Signups</th>
            <th class="px-4 py-3 font-semibold">Weight</th>
            <th class="px-4 py-3 font-semibold">Active</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {
            experiment.variants.map((variant) => {
              const arm = [metrics.control, ...metrics.treatments].find(
                (candidate) => candidate?.variant.id === variant.id
              );
              return (
                <tr class="border-b border-line last:border-0">
                  <td class="px-4 py-3">
                    <span class="font-semibold text-ink">{variant.variant_name}</span>
                    {variant.is_control && (
                      <span class="ml-2 rounded bg-surface-inset px-1.5 py-0.5 font-mono text-[10px] text-ink-subtle">
                        control
                      </span>
                    )}
                    {experiment.winning_variant_id === variant.id && (
                      <span class="ml-2 rounded bg-success-dark/25 px-1.5 py-0.5 font-mono text-[10px] text-success">
                        winner
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-ink-muted">{variant.variant_key}</td>
                  <td class="px-4 py-3 text-right font-mono text-ink-muted">
                    {arm?.db_signups ?? 0}
                  </td>
                  <td class="px-4 py-3">
                    <form
                      method="post"
                      action={`/api/admin/variants/${variant.id}`}
                      class="flex items-center gap-2"
                    >
                      <input type="hidden" name="experiment_id" value={experiment.id} />
                      <input
                        name="weight"
                        type="number"
                        min="0"
                        max="100"
                        value={variant.weight}
                        class="w-20 rounded border border-line-strong bg-surface-inset px-2 py-1 font-mono text-xs text-ink outline-none focus:border-brand"
                      />
                      <button
                        type="submit"
                        class="rounded border border-line-strong px-2 py-1 text-xs font-semibold text-ink-muted hover:text-ink"
                      >
                        Save
                      </button>
                    </form>
                  </td>
                  <td class="px-4 py-3">
                    <form method="post" action={`/api/admin/variants/${variant.id}`}>
                      <input type="hidden" name="experiment_id" value={experiment.id} />
                      <input type="hidden" name="active" value={variant.active ? 'false' : 'true'} />
                      <button
                        type="submit"
                        class:list={[
                          'rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors',
                          variant.active
                            ? 'border-success-dark bg-success-dark/20 text-success'
                            : 'border-line-strong bg-surface-inset text-ink-subtle',
                        ]}
                      >
                        {variant.active ? 'Active' : 'Paused'}
                      </button>
                    </form>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="flex justify-end gap-2">
                      {!variant.is_control && variant.active && (
                        <form method="post" action={`/api/admin/experiments/${experiment.id}`}>
                          <input type="hidden" name="action" value="promote" />
                          <input type="hidden" name="variant_id" value={variant.id} />
                          <button
                            type="submit"
                            class="text-xs font-semibold text-success hover:underline"
                          >
                            Promote
                          </button>
                        </form>
                      )}
                      <form method="post" action={`/api/admin/variants/${variant.id}`}>
                        <input type="hidden" name="experiment_id" value={experiment.id} />
                        <input type="hidden" name="_method" value="delete" />
                        <button type="submit" class="text-xs font-semibold text-error hover:underline">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <form
      method="post"
      action={`/api/admin/experiments/${experiment.id}/variants`}
      class="mt-4 flex flex-wrap items-end gap-3 rounded-xl border border-line bg-surface-raised p-4"
    >
      <div>
        <label for="variant_key" class={labelClass}>Copy key</label>
        <input id="variant_key" name="variant_key" required placeholder="2" class={inputClass} />
      </div>
      <div class="flex-1">
        <label for="variant_name" class={labelClass}>Arm name</label>
        <input
          id="variant_name"
          name="variant_name"
          required
          placeholder="Variant — weekend time compression"
          class={inputClass}
        />
      </div>
      <div>
        <label for="weight" class={labelClass}>Weight</label>
        <input
          id="weight"
          name="weight"
          type="number"
          min="0"
          max="100"
          value="50"
          class={`${inputClass} w-24`}
        />
      </div>
      <button
        type="submit"
        class="rounded-lg border border-line-strong px-4 py-2 text-sm font-semibold text-ink-muted transition-colors hover:border-line-strongest hover:text-ink"
      >
        Add arm
      </button>
    </form>
  </section>

  <!-- ── Copy diff ─────────────────────────────────────────────────────────── -->
  <section class="mb-10">
    <h2 class="mb-3 font-display text-lg font-bold text-ink">Copy under test</h2>
    <div class="overflow-x-auto rounded-xl border border-line bg-surface-raised">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-line text-xs uppercase tracking-wide text-ink-subtle">
          <tr>
            <th class="w-36 px-4 py-3 font-semibold">Field</th>
            {
              experiment.variants.map((variant) => (
                <th class="px-4 py-3 font-semibold">{variant.variant_name}</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            copyFields.map((field) => (
              <tr class="border-b border-line align-top last:border-0">
                <td class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-ink-subtle">
                  {field.label}
                </td>
                {experiment.variants.map((variant) => (
                  <td class="px-4 py-3 text-ink-muted">{copyValue(variant.variant_key, field.key)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-ink-subtle">
      Copy is read from <code class="font-mono">src/lib/copy-dictionary.ts</code> — it ships with the
      build rather than being editable here, so what the dashboard shows is what the page renders.
    </p>
  </section>

  <!-- ── Decision log ──────────────────────────────────────────────────────── -->
  <section class="mb-10">
    <h2 class="mb-3 font-display text-lg font-bold text-ink">Decision log</h2>
    {
      decisions.length === 0 ? (
        <p class="rounded-xl border border-line bg-surface-raised p-5 text-sm text-ink-subtle">
          The agent has not evaluated this experiment yet.
        </p>
      ) : (
        <ul class="space-y-2">
          {decisions.map((decision) => (
            <li class="rounded-xl border border-line bg-surface-raised p-4">
              <div class="flex flex-wrap items-center gap-3">
                <span class:list={['font-mono text-xs font-medium', DECISION_TONE[decision.decision]]}>
                  {decision.decision}
                </span>
                <span class="text-xs text-ink-subtle">
                  {dateFormat.format(new Date(decision.created_at))} · {decision.trigger_source} ·{' '}
                  {decision.metrics_source}
                  {decision.executed ? ' · executed' : ''}
                </span>
                {decision.p_value !== null && (
                  <span class="font-mono text-xs text-ink-subtle">
                    p={Number(decision.p_value).toFixed(4)} · lift{' '}
                    {formatSignedPct(decision.relative_lift_pct)}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{decision.rationale}</p>
              {decision.ai_diagnosis && (
                <p class="mt-2 border-l-2 border-brand/40 pl-3 text-sm leading-relaxed text-ink-muted">
                  {decision.ai_diagnosis}
                  {decision.ai_model && (
                    <span class="ml-2 font-mono text-xs text-ink-subtle">({decision.ai_model})</span>
                  )}
                </p>
              )}
              {decision.action_taken && (
                <p class="mt-2 text-xs text-ink-subtle">{decision.action_taken}</p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- ── Settings ──────────────────────────────────────────────────────────── -->
  <section class="max-w-3xl">
    <h2 class="mb-3 font-display text-lg font-bold text-ink">Settings</h2>
    <form
      method="post"
      action={`/api/admin/experiments/${experiment.id}`}
      class="space-y-5 rounded-xl border border-line bg-surface-raised p-5"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="edit-name" class={labelClass}>Name</label>
          <input id="edit-name" name="name" value={experiment.name} class={inputClass} />
        </div>
        <div>
          <label for="edit-status" class={labelClass}>Status</label>
          <select id="edit-status" name="status" class={inputClass}>
            {
              EXPERIMENT_STATUSES.map((status) => (
                <option value={status} selected={status === experiment.status}>
                  {status}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <div>
        <label for="edit-hypothesis" class={labelClass}>Hypothesis</label>
        <textarea id="edit-hypothesis" name="hypothesis" rows="3" class={inputClass}
          >{experiment.hypothesis}</textarea
        >
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        <div>
          <label for="edit-icp" class={labelClass}>Target ICP</label>
          <select id="edit-icp" name="icp_id" class={inputClass}>
            <option value="">— unchanged —</option>
            {
              icps.map((candidate) => (
                <option value={candidate.id} selected={candidate.id === experiment.icp_id}>
                  {candidate.name}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="edit-baseline" class={labelClass}>Baseline CR %</label>
          <input
            id="edit-baseline"
            name="baseline_cr"
            type="number"
            step="0.01"
            min="0"
            max="100"
            value={experiment.baseline_cr ?? ''}
            class={inputClass}
          />
        </div>
        <div>
          <label for="edit-target" class={labelClass}>Target CR %</label>
          <input
            id="edit-target"
            name="target_cr"
            type="number"
            step="0.01"
            min="0"
            max="100"
            value={experiment.target_cr ?? ''}
            class={inputClass}
          />
        </div>
      </div>

      <button
        type="submit"
        class="rounded-lg bg-brand px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-hover"
      >
        Save changes
      </button>
    </form>

    <form
      method="post"
      action={`/api/admin/experiments/${experiment.id}`}
      class="mt-4 flex items-center justify-between rounded-xl border border-error-dark/40 bg-surface-raised p-4"
    >
      <div>
        <p class="text-sm font-semibold text-ink">Delete experiment</p>
        <p class="text-xs text-ink-subtle">
          Removes the experiment, its arms and its decision history. Signups keep their rows;
          their attribution is cleared.
        </p>
      </div>
      <input type="hidden" name="_method" value="delete" />
      <button
        type="submit"
        class="shrink-0 rounded-lg border border-error-dark px-4 py-2 text-sm font-semibold text-error transition-colors hover:bg-error-dark/20"
      >
        Delete
      </button>
    </form>
  </section>
</AdminShell>
