---
// Experiment registry: list everything, create a new test.
//
// Creation lives on the same screen as the list rather than behind a /new route — the
// form is six fields, and a growth engineer spinning up a test wants to see what is
// already running while naming the next one.
import AdminShell from '../../../components/admin/AdminShell.astro';
import StatusPill from '../../../components/admin/StatusPill.astro';
import { experimentDb } from '../../../lib/experiment-repo';
import { COPY_DICTIONARY } from '../../../lib/copy-dictionary';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const [experiments, icps] = await Promise.all([experimentDb.list(), experimentDb.listIcps()]);

// Treatment arms must map to shipped copy, so the form offers the keys that exist
// rather than a free-text box that fails validation after submit.
const availableKeys = Object.keys(COPY_DICTIONARY).filter((key) => key !== 'control');

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const inputClass =
  'w-full rounded-lg border border-line-strong bg-surface-inset px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-brand';
const labelClass = 'mb-1.5 block text-xs font-semibold uppercase tracking-wide text-ink-subtle';
---

<AdminShell
  title="Experiments"
  subtitle="Every test, its arms, and the traffic it is currently taking."
  active="experiments"
>
  <div class="overflow-x-auto rounded-xl border border-line bg-surface-raised">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-line text-xs uppercase tracking-wide text-ink-subtle">
        <tr>
          <th class="px-4 py-3 font-semibold">Name</th>
          <th class="px-4 py-3 font-semibold">lp</th>
          <th class="px-4 py-3 font-semibold">Arms</th>
          <th class="px-4 py-3 font-semibold">Metric</th>
          <th class="px-4 py-3 font-semibold">Started</th>
          <th class="px-4 py-3 font-semibold">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {
          experiments.map((experiment) => (
            <tr class="border-b border-line last:border-0 hover:bg-surface-inset/50">
              <td class="px-4 py-3">
                <a
                  href={`/marketingengine/experiments/${experiment.id}`}
                  class="font-semibold text-ink hover:text-brand-light"
                >
                  {experiment.name}
                </a>
                <p class="mt-0.5 max-w-md truncate text-xs text-ink-subtle">
                  {experiment.hypothesis}
                </p>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-ink-muted">{experiment.id}</td>
              <td class="px-4 py-3">
                <span class="font-mono text-xs text-ink-muted">
                  {experiment.variants.filter((variant) => variant.active).length}/
                  {experiment.variants.length} active
                </span>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-ink-muted">
                {experiment.primary_metric}
              </td>
              <td class="px-4 py-3 text-xs text-ink-subtle">
                {experiment.started_at
                  ? dateFormat.format(new Date(experiment.started_at))
                  : 'Not started'}
              </td>
              <td class="px-4 py-3">
                <StatusPill status={experiment.status} />
              </td>
              <td class="px-4 py-3 text-right">
                <a
                  href={`/marketingengine/experiments/${experiment.id}`}
                  class="text-xs font-semibold text-brand-light hover:underline"
                >
                  Inspect
                </a>
              </td>
            </tr>
          ))
        }
        {
          experiments.length === 0 && (
            <tr>
              <td colspan="7" class="px-4 py-10 text-center text-ink-subtle">
                No experiments yet — create the first one below.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>

  <section class="mt-10 max-w-3xl">
    <h2 class="mb-1 font-display text-lg font-bold text-ink">New experiment</h2>
    <p class="mb-5 text-sm text-ink-subtle">
      A control arm is created automatically. Treatment arms are named by their
      <code class="font-mono text-xs text-brand-light">COPY_DICTIONARY</code> key, so the copy they serve
      is the copy that shipped with the build.
    </p>

    <form
      method="post"
      action="/api/admin/experiments"
      class="space-y-5 rounded-xl border border-line bg-surface-raised p-5"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="id" class={labelClass}>Experiment id (?lp= value)</label>
          <input id="id" name="id" required placeholder="2" class={inputClass} />
          <p class="mt-1 text-xs text-ink-subtle">Appears in ad URLs as /freetrial?lp=…</p>
        </div>

        <div>
          <label for="name" class={labelClass}>Name</label>
          <input
            id="name"
            name="name"
            required
            placeholder="weekend_time_compression_headline"
            class={inputClass}
          />
        </div>
      </div>

      <div>
        <label for="hypothesis" class={labelClass}>Hypothesis</label>
        <textarea
          id="hypothesis"
          name="hypothesis"
          required
          rows="3"
          placeholder="Framing the hero around … converts better than … because …"
          class={inputClass}></textarea>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="icp_id" class={labelClass}>Target ICP</label>
          <select id="icp_id" name="icp_id" class={inputClass}>
            <option value="">— none —</option>
            {icps.map((icp) => <option value={icp.id}>{icp.name}</option>)}
          </select>
        </div>

        <div>
          <label for="variant_keys" class={labelClass}>Treatment arms</label>
          <input
            id="variant_keys"
            name="variant_keys"
            placeholder="2"
            class={inputClass}
            list="copy-keys"
          />
          <datalist id="copy-keys">
            {availableKeys.map((key) => <option value={key}>{COPY_DICTIONARY[key].eyebrow}</option>)}
          </datalist>
          <p class="mt-1 text-xs text-ink-subtle">
            Comma-separated. Available: {availableKeys.join(', ') || 'none'}
          </p>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        <div>
          <label for="baseline_cr" class={labelClass}>Baseline CR %</label>
          <input
            id="baseline_cr"
            name="baseline_cr"
            type="number"
            step="0.01"
            min="0"
            max="100"
            placeholder="3.20"
            class={inputClass}
          />
        </div>
        <div>
          <label for="target_cr" class={labelClass}>Target CR %</label>
          <input
            id="target_cr"
            name="target_cr"
            type="number"
            step="0.01"
            min="0"
            max="100"
            placeholder="4.00"
            class={inputClass}
          />
        </div>
        <div>
          <label for="status" class={labelClass}>Status</label>
          <select id="status" name="status" class={inputClass}>
            <option value="draft">Draft</option>
            <option value="running">Running</option>
          </select>
        </div>
      </div>

      <button
        type="submit"
        class="rounded-lg bg-brand px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-hover"
      >
        Create experiment
      </button>
    </form>
  </section>
</AdminShell>
